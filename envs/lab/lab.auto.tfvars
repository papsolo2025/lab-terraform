# Environment configuration for the LAB environment - committed to Git and reviewed in pull requests.
# Enterprise pattern: one reviewed file per environment (dev.auto.tfvars, prod.auto.tfvars ...).
# Personal values (your IP, email, SSH key) live in personal.auto.tfvars, which is git-ignored.
# Secrets never go in any tfvars file - the database password is generated by RDS in Secrets Manager.
# Terraform loads every *.auto.tfvars file in this folder automatically.

region       = "us-west-2"
project      = "devops-lab"
cluster_name = "devops-lab"
timezone     = "America/Vancouver"

# Network
vpc_cidr = "10.20.0.0/16"

# Kubernetes - one version behind the newest, for the upgrade exercise
kubernetes_version = "1.36"
node_instance_type = "t3.medium"
node_capacity_type = "ON_DEMAND" # SPOT saves 60-70% with interruption risk

# Database
db_instance_class = "db.t4g.micro"

# Guardrails
monthly_budget_usd  = 200
enable_nightly_stop = true
protect_data        = true # set false (with -var protect_data=false) only for the final teardown

# Paid production options - off to keep the lab cheap; turn on for the HA / audit exercises
db_multi_az        = false # about +$12/month
nat_gateway_per_az = false # about +$33/month
enable_flow_logs   = false # a few dollars/month
