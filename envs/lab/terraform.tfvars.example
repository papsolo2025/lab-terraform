# Copy to terraform.tfvars and fill in. terraform.tfvars is in .gitignore - never commit it.
owner       = "your-name"
my_ip_cidr  = "203.0.113.10/32" # curl -s https://checkip.amazonaws.com  then add /32
alert_email = "you@example.com"

# cat ~/.ssh/devops-lab.pub
ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

# Optional overrides
# region             = "us-west-2"
# kubernetes_version = "1.36"
# node_capacity_type = "SPOT"
# monthly_budget_usd = 200
